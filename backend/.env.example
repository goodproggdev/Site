# Copia questo file e rinominalo .env nella cartella backend/
# NON committare mai il file .env reale!

DEBUG=True
SECRET_KEY=django-insecure-CAMBIA-QUESTO-SEGRETO-IN-PRODUZIONE
ALLOWED_HOSTS=localhost,127.0.0.1

# Nome e dominio per django.contrib.sites (email di conferma registrazione / allauth)
SITE_NAME=Nordevit
SITE_DOMAIN=localhost:8000

# URL base della SPA (senza slash finale). Usato nei link email (reset password, ecc.)
FRONTEND_URL=http://localhost:5173
FRONTEND_DEFAULT_LANG=it
# Pagina CV pubblica servita da Django su /u/<slug>/ (meta SEO senza JS). Dopo `npm run build` nel frontend:
# FRONTEND_DIST_INDEX_HTML=C:\path\to\Site-main\frontend\dist\index.html
FRONTEND_DIST_INDEX_HTML=
# Origine assoluta degli asset /assets/... (vuoto = stesso host della richiesta; utile con CDN).
FRONTEND_ASSET_ORIGIN=
# URL immagine Open Graph assoluta per i link CV (opzionale).
PUBLIC_CV_OG_IMAGE=

# Error tracking (Sentry, opzionale) - vuoto = disabilitato, nessun crash se manca.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# mandatory = registrazione invia mail, niente login JWT fino alla conferma (consigliato anche in dev).
# none = accesso immediato senza conferma (solo se esplicitamente richiesto).
ACCOUNT_EMAIL_VERIFICATION=mandatory

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tua.email@gmail.com
EMAIL_HOST_PASSWORD=app-password-gmail
EMAIL_RECIPIENT=destinatario@gmail.com

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# In Stripe Dashboard → Webhooks: aggiungi almeno checkout.session.completed,
# customer.subscription.updated e customer.subscription.deleted (stesso endpoint /api/v1/stripe/webhook/).
STRIPE_WEBHOOK_SECRET=whsec_...

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Database (production)
# Example: postgres://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

# S3-compatible storage (production)
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=

# Parsing CV: se True, estrazione strutturata EN via OpenAI (richiede OPENAI_API_KEY).
# Altrimenti si usa pyresparser + spaCy (dopo `pip install -r requirements.txt`: `python manage.py setup_cv_nlp`).
CV_PARSE_USE_OPENAI=False
OPENAI_API_KEY=
OPENAI_CV_MODEL=gpt-4o-mini
CV_OPENAI_TIMEOUT_SEC=18
CV_OPENAI_TEXT_MAX_CHARS=9000
CV_OPENAI_TEXT_MAX_TOKENS=1200
CV_OPENAI_VISION_MAX_TOKENS=1200

# Estrazione CV: LibreOffice opzionale (path a soffice / soffice.exe) per .doc e DOCX “difficili”.
# Linux: es. apt install libreoffice (poi which soffice). Windows: path tipico
# "C:\Program Files\LibreOffice\program\soffice.exe". Docker: immagine con libreoffice-writer.
CV_EXTRACT_MIN_CHARS=80
CV_FAST_SCORE_THRESHOLD=0.62
CV_FAST_MIN_CHARS_FOR_OPENAI=80
CV_LIBREOFFICE_BIN=
CV_LIBREOFFICE_TIMEOUT=90

# PDF senza testo: parsing via OpenAI vision (prime pagine rasterizzate; richiede pymupdf)
CV_PARSE_USE_PDF_VISION=False
OPENAI_CV_VISION_MODEL=gpt-4o-mini
CV_PDF_VISION_MAX_PAGES=3

# PDF senza testo: fallback opzionale via Gemini (legacy, non usato nel fast-path principale)
CV_PARSE_USE_GEMINI_PDF=False
GEMINI_API_KEY=
GEMINI_CV_PDF_MODEL=gemini-1.5-flash
