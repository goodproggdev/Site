# Frontend — variabili d'ambiente Vite
# Copia come .env.local e modifica i valori

VITE_API_BASE_URL=http://localhost:8000
# Backward compatibility for older code paths
VITE_API_URL=http://localhost:8000
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Google Analytics 4 — ID misurazione (es. G-XXXXXXXX). Opzionale; senza valore GA4 non viene caricato.
VITE_GA_MEASUREMENT_ID=

# URL completo della pagina LinkedIn aziendale (footer). Esempio: https://www.linkedin.com/company/tua-azienda/
VITE_LINKEDIN_COMPANY_URL=

# Titolo del browser dopo aver lasciato una pagina CV pubblica (opzionale)
VITE_DEFAULT_DOCUMENT_TITLE=Nordevit
